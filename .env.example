# Leave ANTHROPIC_API_KEY unset to use subscription credentials from a prior
# `claude` login (~/.claude). Set it only if you deliberately want metered
# API billing. See Phase 0 in the README before choosing.
# ANTHROPIC_API_KEY=

# Root the agent is launched in. Everything else is added explicitly.
HELM_HOME_ROOT=$HOME

# Extra roots the agent may touch, colon-separated. Empty = home root only.
HELM_EXTRA_ROOTS=

# off | prompt | auto  — prompt routes every tool call to the approval UI.
HELM_PERMISSION_MODE=prompt

# Shell spawned in the PTY pane.
HELM_SHELL=/bin/zsh
