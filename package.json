{
  "name": "helm",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @helm/desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "package": "pnpm --filter @helm/desktop package",
    "sign:dev": "./scripts/sign-dev.sh",
    "postinstall": "node scripts/postinstall.mjs",
    "lint:scripts": "eslint scripts eslint.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.7.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8"
  }
}
